# Copy to ~/.config/forex/plane-mcp.env and chmod 600 that file.
# Reuse the existing Planner token only until a dedicated Forex token is issued.
# This file is local-only. Never put it in Git, logs, task descriptions, or evidence.
PLANE_API_KEY=replace-with-reused-Planner-token
PLANE_WORKSPACE_SLUG=forex
# MCP expects the Plane API base URL, including /api (unlike H5 REST).
PLANE_BASE_URL=http://replace-with-T480-Plane-host:8090/api
