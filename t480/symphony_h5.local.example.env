# Copy to ~/.config/forex/symphony-h5.env on T480, then chmod 600 that file.
# Do not add this file to Git. Use a least-privilege Plane token.
# T480-local Plane origin; H5 adds /api/v1 itself.
FOREX_PLANE_URL=http://127.0.0.1:8090
FOREX_PLANE_API_TOKEN=replace-with-local-plane-token
# Fixed board identifier. The installer resolves and retains the returned
# immutable UUID only in protected ~/.local/state/forex-symphony-h5/plane-board.json.
FOREX_PLANE_WORKSPACE=forex
FOREX_PLANE_PROJECT=FXD
# Exact clean revision explicitly approved by the human operator. Do not use HEAD.
FOREX_SYMPHONY_BASELINE_REVISION=replace-with-40-character-commit-sha
