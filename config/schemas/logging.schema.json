{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "level", "format", "output_directory", "redacted_fields"],
  "properties": {
    "schema_version": {"const": "forex.logging.v1"},
    "level": {"enum": ["DEBUG", "INFO", "WARNING", "ERROR"]},
    "format": {"const": "JSON"},
    "output_directory": {"type": "string", "minLength": 1},
    "redacted_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
