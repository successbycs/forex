{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M33 MT5 process inventory",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "processes", "inventory_sha256"],
  "properties": {
    "schema_version": {"const": "forex.trading-health-mt5-inventory.v1"},
    "inventory_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "processes": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["pid", "path", "session_id", "command_line_sha256", "parent_pid", "parent_path", "creation_id", "classification"],
      "properties": {"pid": {"type":"integer","minimum":1}, "path":{"type":"string","minLength":1}, "session_id":{"type":"integer","minimum":0}, "command_line_sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}, "parent_pid":{"type":"integer","minimum":0}, "parent_path":{"type":"string","minLength":1}, "creation_id":{"type":"string","minLength":1}, "classification":{"enum":["PRIMARY_MANAGED","ADDITIONAL_MANAGED","UNATTRIBUTABLE"]}}}}
  }
}
