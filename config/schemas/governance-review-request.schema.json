{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "milestone_id", "purpose", "created_at", "git_revision", "configuration_fingerprint", "milestone_contract_sha256", "verification_recorded_at", "builder_report_path", "builder_report_sha256", "review_cycle"],
  "properties": {
    "schema_version": {"const": "forex.governance-review-request.v1"},
    "request_id": {"type": "string", "minLength": 1},
    "milestone_id": {"pattern": "^M[0-9]+$"},
    "purpose": {"const": "IMPLEMENTATION_READINESS"},
    "created_at": {"type": "string", "format": "date-time"},
    "git_revision": {"pattern": "^[a-f0-9]{40}$"},
    "configuration_fingerprint": {"pattern": "^sha256:[a-f0-9]{64}$"},
    "milestone_contract_sha256": {"pattern": "^[a-f0-9]{64}$"},
    "verification_recorded_at": {"type": "string", "format": "date-time"},
    "builder_report_path": {"type": "string", "minLength": 1},
    "builder_report_sha256": {"pattern": "^[a-f0-9]{64}$"},
    "review_cycle": {"type": "integer", "minimum": 1, "maximum": 3}
  }
}
