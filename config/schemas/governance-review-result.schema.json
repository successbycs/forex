{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "milestone_id", "request_sha256", "git_revision", "configuration_fingerprint", "milestone_contract_sha256", "review_cycle", "reviewer", "outcome", "summary", "required_findings", "optional_observations", "attestations", "reviewed_at"],
  "properties": {
    "schema_version": {"const": "forex.governance-review-result.v1"},
    "request_id": {"type": "string", "minLength": 1},
    "milestone_id": {"pattern": "^M[0-9]+$"},
    "request_sha256": {"pattern": "^[a-f0-9]{64}$"},
    "git_revision": {"pattern": "^[a-f0-9]{40}$"},
    "configuration_fingerprint": {"pattern": "^sha256:[a-f0-9]{64}$"},
    "milestone_contract_sha256": {"pattern": "^[a-f0-9]{64}$"},
    "review_cycle": {"type": "integer", "minimum": 1, "maximum": 3},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "session_id"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1}
      }
    },
    "outcome": {"enum": ["CHANGES_REQUIRED", "BLOCKED", "READY_FOR_EVIDENCE"]},
    "summary": {"type": "string", "minLength": 1},
    "required_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "severity", "title", "detail", "recommended_action"],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]},
          "title": {"type": "string", "minLength": 1},
          "detail": {"type": "string", "minLength": 1},
          "recommended_action": {"type": "string", "minLength": 1}
        }
      }
    },
    "optional_observations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "attestations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_only", "fresh_context", "did_not_modify_repository"],
      "properties": {
        "read_only": {"const": true},
        "fresh_context": {"const": true},
        "did_not_modify_repository": {"const": true}
      }
    },
    "reviewed_at": {"type": "string", "format": "date-time"}
  }
}
