{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_cycle_id", "milestone_id", "role", "reviewer", "binding", "verdict", "summary", "criteria_assessments", "findings", "limitations", "attestations", "reviewed_at"],
  "properties": {
    "schema_version": {"type": "string", "const": "forex.triad-review.v1"},
    "review_cycle_id": {"type": "string", "minLength": 1},
    "milestone_id": {"pattern": "^M[0-9]+$"},
    "role": {"enum": ["AI_ENGINEER", "SOLUTION_ARCHITECT", "SENIOR_SOFTWARE_DEVELOPER", "FINANCIAL_DOMAIN_EXPERT"]},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "provider", "model", "session_id"],
      "properties": {
        "kind": {"enum": ["AI", "HUMAN"]},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_sha256", "git_revision", "configuration_fingerprint", "evidence_manifest_sha256", "verifier_fingerprint", "milestone_contract_sha256", "role_prompt_sha256"],
      "properties": {
        "request_sha256": {"pattern": "^[a-f0-9]{64}$"},
        "git_revision": {"pattern": "^[a-f0-9]{40}$"},
        "configuration_fingerprint": {"pattern": "^sha256:[a-f0-9]{64}$"},
        "evidence_manifest_sha256": {"pattern": "^[a-f0-9]{64}$"},
        "verifier_fingerprint": {"pattern": "^sha256:[a-f0-9]{64}$"},
        "milestone_contract_sha256": {"pattern": "^[a-f0-9]{64}$"},
        "role_prompt_sha256": {"pattern": "^[a-f0-9]{64}$"}
      }
    },
    "verdict": {"enum": ["PASS", "PASS_WITH_FINDINGS", "FAIL", "ABSTAIN"]},
    "summary": {"type": "string", "minLength": 1},
    "criteria_assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "result", "rationale", "evidence_refs"],
        "properties": {
          "criterion_id": {"pattern": "^M[0-9]+-C[0-9]+$"},
          "result": {"enum": ["PASS", "FAIL", "NOT_REVIEWED"]},
          "rationale": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "severity", "status", "title", "detail", "evidence_refs", "recommended_action"],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]},
          "status": {"enum": ["OPEN", "RESOLVED", "ACCEPTED_RISK"]},
          "title": {"type": "string", "minLength": 1},
          "detail": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "recommended_action": {"type": "string", "minLength": 1}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "attestations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_only", "independent_context", "raw_evidence_reviewed", "did_not_modify_repository", "no_other_review_seen_before_verdict"],
      "properties": {
        "read_only": {"type": "boolean", "const": true},
        "independent_context": {"type": "boolean", "const": true},
        "raw_evidence_reviewed": {"type": "boolean", "const": true},
        "did_not_modify_repository": {"type": "boolean", "const": true},
        "no_other_review_seen_before_verdict": {"type": "boolean", "const": true}
      }
    },
    "reviewed_at": {"type": "string", "format": "date-time"}
  }
}
