{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_cycle_id", "milestone_id", "generated_at", "binding", "reviews", "recommendation", "blocking_reasons", "observations", "human_decision_required"],
  "properties": {
    "schema_version": {"const": "forex.triad-recommendation.v1"},
    "review_cycle_id": {"type": "string", "minLength": 1},
    "milestone_id": {"pattern": "^M[0-9]+$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_sha256", "git_revision", "configuration_fingerprint", "evidence_manifest_sha256", "verifier_fingerprint", "milestone_contract_sha256"],
      "properties": {
        "request_sha256": {"pattern": "^[a-f0-9]{64}$"},
        "git_revision": {"pattern": "^[a-f0-9]{40}$"},
        "configuration_fingerprint": {"pattern": "^sha256:[a-f0-9]{64}$"},
        "evidence_manifest_sha256": {"pattern": "^[a-f0-9]{64}$"},
        "verifier_fingerprint": {"pattern": "^sha256:[a-f0-9]{64}$"},
        "milestone_contract_sha256": {"pattern": "^[a-f0-9]{64}$"}
      }
    },
    "reviews": {"type": "array", "items": {"type": "object"}},
    "recommendation": {"enum": ["RECOMMEND_COMPLETE", "DO_NOT_COMPLETE"]},
    "blocking_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "observations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "human_decision_required": {"const": true}
  }
}
