# Copy only for machine-local T480 access; never commit the populated file.
T480_SSH_TARGET=

# The only non-secret M0 configuration override.
FOREX_LOG_LEVEL=INFO

# Local administrator connection details for the shared T480 PostgreSQL service.
# Copy the values from the T480 shared-lab .env; do not commit the populated file.
FOREX_POSTGRES_HOST=192.168.0.210
FOREX_POSTGRES_PORT=5432
FOREX_POSTGRES_DB=
FOREX_POSTGRES_USER=
FOREX_POSTGRES_PASSWORD=
FOREX_POSTGRES_SSLMODE=disable

# Required only for M8's fixed, read-only FRED/ALFRED vintage-data proof.
# Obtain this from FRED and keep it in the ignored local .env file.
FRED_API_KEY=
